# --- Undermine Exchange (default/main source) ---
# Sign in with Patreon at https://undermine.exchange/ then reveal your key:
# https://undermine.exchange/api.html
UNDERMINE_API_KEY=your_undermine_key_here

# --- Blizzard Game Data API (optional second source) ---
# Create an application at https://develop.battle.net/ (no special scopes needed)
BLIZZARD_CLIENT_ID=your_blizzard_client_id_here
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret_here
